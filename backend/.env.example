# LoanLens backend configuration. Spring Boot reads ENVIRONMENT VARIABLES; it does not read this file by itself.
# Set these in your terminal / IDE run configuration / hosting settings. Never commit real values.
# (If you keep a local .env, it is git-ignored: `.env`. This example is never overwritten by anything.)

# --- database ---
DB_URL=jdbc:postgresql://localhost:5432/loanlens_db
DB_USERNAME=postgres
DB_PASSWORD=
LOANLENS_SEED_ENABLED=false

# --- AI explanations (Anthropic) ---
# Leave AI_API_KEY empty to run without AI: /api/ai/explain then answers with a clearly labelled deterministic explanation.
# Get a key in the Anthropic Console, then set it ONLY in the backend's environment, e.g. PowerShell:
#     $env:AI_API_KEY = "<your key>"
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
# AI_MAX_OUTPUT_TOKENS=4000
# AI_RATE_LIMIT_PER_MINUTE=20
# AI_BASE_URL=            # blank = Anthropic's own endpoint (https://api.anthropic.com); only for tests/proxies
