# Copy to .env.local and adjust. Only VITE_* variables reach the browser: NEVER put secrets here.

# true  = in-memory mock backend with demonstration data (works with no backend running)
# false = the real Spring Boot API at VITE_API_BASE_URL (no silent fallback to sample data)
VITE_USE_MOCK_DATA=true

# Spring Boot API base URL INCLUDING the /api prefix (used when VITE_USE_MOCK_DATA=false)
VITE_API_BASE_URL=http://localhost:8080/api

# AI Insights in backend mode calls POST /ai/explain. It is ON by default; set false to switch the page off.
# The AI provider key is NEVER set here: it belongs to the Spring Boot backend (AI_API_KEY), see docs/AI_EXPLANATIONS.md.
# VITE_AI_ENABLED=true

# Optional
# VITE_MOCK_LATENCY_MS=450
# VITE_API_TIMEOUT_MS=15000
# VITE_API_WITH_CREDENTIALS=false
