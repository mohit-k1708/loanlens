# Backend integration mode. Copy to .env.live (git-ignored), then run: npm run dev:live
# Needs the Spring Boot backend running at VITE_API_BASE_URL. Only VITE_* values reach the browser: NEVER put secrets here.
VITE_USE_MOCK_DATA=false
VITE_API_BASE_URL=http://localhost:8080/api
# VITE_AI_ENABLED=true
